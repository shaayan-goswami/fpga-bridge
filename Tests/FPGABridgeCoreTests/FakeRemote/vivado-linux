#!/bin/bash
# Fake Vivado launcher for Linux tests. fpga-bridge runs it as
#   vivado -mode batch -nojournal -nolog -source <script> [-tclargs fpgabridge-<token>]
# inside a job directory (a build) or the home directory (a one-off script).
#
# FAKE_VIVADO_MODE: "pass" (default), "fail", "fail-impl", "hang" (runs until killed) or "lost" (connection drops
# mid-run). A build runs FAKE_FLOW (fake-flow).
set -u
HOME_="${FAKE_HOME:?FAKE_HOME not set}"

[ "${1:-}" = "-version" ] && { echo "vivado v2023.2 (64-bit)"; exit 0; }

source_file=""; marker=""
while [ $# -gt 0 ]; do
  case "$1" in
    -source) source_file="$2"; shift ;;
    -tclargs) marker="$2"; shift ;;
  esac
  shift
done

# A one-off Tcl script.
if [ -z "$marker" ]; then
  [ -f "$source_file" ] || { echo "ERROR: script not found" >&2; exit 1; }
  echo "fake-vivado ran:"
  cat "$source_file"
  exit 0
fi

# A build: run build.tcl the way Vivado would.
echo "fake-vivado: $0"
case "${FAKE_VIVADO_MODE:-pass}" in
  fail) echo "ERROR: [Synth 8-439] module 'missing_module' not declared"; exit 1 ;;
  lost) echo "client_loop: send disconnect: Broken pipe" >&2; exit 255 ;;
  # The marker file says "Vivado is up", which is what a test waits for before pressing Ctrl-C. `exec -a` keeps the
  # job's marker on the process's command line, as real Vivado does, so `pkill -f` can find it.
  hang)
    echo $$ > "$HOME_/.pid"; : > "$HOME_/.running"; echo "fake-vivado: running"
    exec -a "fake-vivado $marker" sleep 30 ;;
esac
exec "${FAKE_FLOW:?FAKE_FLOW not set}"
