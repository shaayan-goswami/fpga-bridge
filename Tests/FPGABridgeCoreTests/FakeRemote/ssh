#!/bin/bash
# Fake `ssh` for tests. Pretends to be a Windows machine whose user profile is $FAKE_HOME.
#
# It only understands the exact cmd.exe command lines fpga-bridge is supposed to send, and exits 127 on anything
# else, so an accidental change to those command lines fails a test instead of passing silently.
#
# Environment:
#   FAKE_HOME          directory standing in for the Windows user profile (required)
#   FAKE_LOG           file that every invocation is appended to
#   FAKE_SSH_FAIL      "permission" or "refused" to simulate a failed login
#   FAKE_VIVADO_PATH   the one vivado.bat path that "exists"
#   FAKE_VIVADO_MODE   "pass" (default), "fail", "fail-impl", "hang" (runs until killed) or "lost" (connection drops)
#   FAKE_REPORT_DIR    directory holding timing_summary.rpt and utilization.rpt for a passing build
#   FAKE_FLOW          the fake Vivado that runs a build.tcl (fake-flow)
set -u
HOME_="${FAKE_HOME:?FAKE_HOME not set}"
LOG="${FAKE_LOG:-/dev/null}"

echo "ssh $*" >> "$LOG"

target=""; cmd=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o|-i) shift 2; continue ;;
    -*) shift; continue ;;
    *) if [ -z "$target" ]; then target="$1"; else cmd="$1"; fi ;;
  esac
  shift
done

case "${FAKE_SSH_FAIL:-}" in
  permission) echo "$target: Permission denied (publickey,password,keyboard-interactive)." >&2; exit 255 ;;
  refused) echo "ssh: connect to host ${target#*@} port 22: Connection refused" >&2; exit 255 ;;
esac

if [ "$cmd" = "echo ok" ]; then
  echo ok; exit 0
fi

if [ "$cmd" = "if not exist .fpga-bridge mkdir .fpga-bridge" ]; then
  mkdir -p "$HOME_/.fpga-bridge"; exit 0
fi

# Parentheses are required: in cmd.exe, text after `&` on an `if` line belongs to that `if`.
re='^\(if not exist \.fpga-bridge mkdir \.fpga-bridge\) & \(if exist \.fpga-bridge\\([A-Za-z0-9_-]+) rmdir /s /q \.fpga-bridge\\([A-Za-z0-9_-]+)\)$'
if [[ "$cmd" =~ $re ]] && [ "${BASH_REMATCH[1]}" = "${BASH_REMATCH[2]}" ]; then
  mkdir -p "$HOME_/.fpga-bridge"
  rm -rf "$HOME_/.fpga-bridge/${BASH_REMATCH[1]}"
  exit 0
fi

# Take the build lock: mkdir fails if it exists, and only then is the owner file written.
re='^\(if not exist \.fpga-bridge mkdir \.fpga-bridge\) & mkdir \.fpga-bridge\\lock && echo ([A-Za-z0-9@._: -]*[A-Za-z])> \.fpga-bridge\\lock\\owner\.txt$'
if [[ "$cmd" =~ $re ]]; then
  mkdir -p "$HOME_/.fpga-bridge"
  if mkdir "$HOME_/.fpga-bridge/lock" 2>/dev/null; then
    echo "${BASH_REMATCH[1]}" > "$HOME_/.fpga-bridge/lock/owner.txt"; exit 0
  fi
  echo "A subdirectory or file .fpga-bridge\\lock already exists." >&2; exit 1
fi

if [ "$cmd" = 'type .fpga-bridge\lock\owner.txt' ]; then
  cat "$HOME_/.fpga-bridge/lock/owner.txt" 2>/dev/null && exit 0
  echo "The system cannot find the file specified." >&2; exit 1
fi

# Mark the lock as in use, as a build does when Vivado finishes.
re='^echo ([A-Za-z0-9@._: -]*[A-Za-z])> \.fpga-bridge\\lock\\owner\.txt$'
if [[ "$cmd" =~ $re ]]; then
  [ -d "$HOME_/.fpga-bridge/lock" ] || { echo "The system cannot find the path specified." >&2; exit 1; }
  echo "${BASH_REMATCH[1]}" > "$HOME_/.fpga-bridge/lock/owner.txt"; exit 0
fi

# Is the lock free, held, or left behind? Held while a job runs (.running) or within 10 minutes of being touched.
if [ "$cmd" = "powershell -NoProfile -NonInteractive -Command \"if (-not (Test-Path .fpga-bridge\\lock)) { 'free' } elseif (Get-CimInstance Win32_Process | Where-Object { \$_.CommandLine -match 'fpgabridge-[0-9a-f]{8}' -and \$_.ProcessId -ne \$PID }) { 'held' } elseif (((Get-Date) - (Get-Item .fpga-bridge\\lock\\owner.txt, .fpga-bridge\\lock -ErrorAction SilentlyContinue | Sort-Object LastWriteTime | Select-Object -Last 1).LastWriteTime).TotalMinutes -lt 10) { 'held' } else { 'stale' }\"" ]; then
  if [ ! -d "$HOME_/.fpga-bridge/lock" ]; then echo free
  elif [ -e "$HOME_/.running" ] || [ -n "$(find "$HOME_/.fpga-bridge/lock" -maxdepth 1 -mmin -10)" ]; then echo held
  else echo stale; fi
  exit 0
fi

# vivado -version, as Vivado 2025.2 answers it.
re='^call "([^"]+)" -version$'
if [[ "$cmd" =~ $re ]]; then
  [ "${BASH_REMATCH[1]}" = "${FAKE_VIVADO_PATH:-}" ] || { echo "The system cannot find the path specified." >&2; exit 1; }
  printf 'vivado v2023.2 (64-bit)\r\nTool Version Limit: 2023.10\r\n'; exit 0
fi

if [ "$cmd" = 'rmdir /s /q .fpga-bridge\lock' ]; then
  rm -rf "$HOME_/.fpga-bridge/lock"; exit 0
fi

if [ "$cmd" = '(if exist .fpga-bridge\lock rmdir /s /q .fpga-bridge\lock)' ]; then
  rm -rf "$HOME_/.fpga-bridge/lock"; exit 0
fi

re='^if exist "([^"]+)" \(echo found\) else \(echo missing\)$'
if [[ "$cmd" =~ $re ]]; then
  if [ "${BASH_REMATCH[1]}" = "${FAKE_VIVADO_PATH:-}" ]; then echo found; else echo missing; fi
  exit 0
fi

# A full build: cd into the job directory and run Vivado on build.tcl.
re='^cd \.fpga-bridge\\([A-Za-z0-9_-]+) && call "([^"]+)" -mode batch -nojournal -log vivado\.log -source build\.tcl -tclargs fpgabridge-([a-f0-9]{8})$'
if [[ "$cmd" =~ $re ]]; then
  name="${BASH_REMATCH[1]}"; viv="${BASH_REMATCH[2]}"
  dir="$HOME_/.fpga-bridge/$name"
  [ -d "$dir" ] || { echo "The system cannot find the path specified." >&2; exit 1; }
  cd "$dir" || exit 1
  echo "fake-vivado: $viv"
  case "${FAKE_VIVADO_MODE:-pass}" in
    fail) echo "ERROR: [Synth 8-439] module 'missing_module' not declared"; exit 1 ;;
    lost) echo "client_loop: send disconnect: Broken pipe" >&2; exit 255 ;;
    # The marker file says "Vivado is up and running", which is what a test must wait for before pressing Ctrl-C.
    hang) : > "$HOME_/.running"; echo "fake-vivado: running"; exec sleep 30 ;;
  esac
  exec "${FAKE_FLOW:?FAKE_FLOW not set}"
fi

# A file under .fpga-bridge (a checkpoint's manifest, a job's done.txt): print it, or fail as `type` does.
re='^type (\.fpga-bridge\\[A-Za-z0-9_.\\-]+)$'
if [[ "$cmd" =~ $re ]]; then
  cat "$HOME_/${BASH_REMATCH[1]//\\//}" 2>/dev/null && exit 0
  echo "The system cannot find the path specified." >&2; exit 1
fi

# Cancel: kill the job by marker. The marker is split in two so this command line doesn't contain it.
re='^powershell -NoProfile -NonInteractive -Command "Get-CimInstance Win32_Process \| Where-Object \{ \$_\.CommandLine -like \(.\*fpgabridge-. \+ .([a-f0-9]{8})\*.\) -and \$_\.ProcessId -ne \$PID \} \| ForEach-Object \{ taskkill /F /T /PID \$_\.ProcessId \}"$'
if [[ "$cmd" =~ $re ]]; then
  echo "${BASH_REMATCH[1]}" >> "$HOME_/.cancelled"
  exit 0
fi

# A one-off Tcl script.
re='^call "([^"]+)" -mode batch -nojournal -nolog -source (\.fpga-bridge\\job-[A-Za-z0-9-]+\.tcl)$'
if [[ "$cmd" =~ $re ]]; then
  file="$HOME_/${BASH_REMATCH[2]//\\//}"
  [ -f "$file" ] || { echo "ERROR: script not found" >&2; exit 1; }
  echo "fake-vivado ran:"
  cat "$file"
  exit 0
fi

re='^del (\.fpga-bridge\\job-[A-Za-z0-9-]+\.tcl)$'
if [[ "$cmd" =~ $re ]]; then
  rm -f "$HOME_/${BASH_REMATCH[1]//\\//}"
  exit 0
fi

echo "fake-ssh: unhandled command: $cmd" >&2
exit 127
